+    ('DE', 'Berlin'), ('DE', 'Frankfurt'),
+    ('JP', 'Tokyo'), ('JP', 'Osaka'),
+    ('AU', 'Sydney'), ('AU', 'Melbourne'),
+    ('MY', 'George Town'), ('MY', 'Kuala Lumpur')
+) AS v("IsoCode2", "Name") ON v."IsoCode2" = c."IsoCode2"
+ON CONFLICT ("CountryId", "Name") DO NOTHING;

diff --git a/schema.sql b/schema.sql
index af3a6a7..b82abe6 100644
--- a/schema.sql
+++ b/schema.sql
@@ -508,3 +508,88 @@ DROP TRIGGER IF EXISTS "TR_GalleryAlbums_UpdatedAt" ON "GalleryAlbums";
 CREATE TRIGGER "TR_GalleryAlbums_UpdatedAt"
     BEFORE UPDATE ON "GalleryAlbums"
     FOR EACH ROW EXECUTE FUNCTION neverbeen_set_updated_at();
+
+-- ============================================================================
+-- AI Model Portfolio Media Engagement (seen, likes, comments, shares)
+-- ============================================================================
+
+CREATE TABLE IF NOT EXISTS "ModelMediaViews" (
+    "Id"           bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "ModelSlug"    varchar(120) NOT NULL,
+    "MediaType"    varchar(16) NOT NULL DEFAULT 'photo',
+    "MediaKey"     varchar(512) NOT NULL,
+    "ViewerId"     integer REFERENCES "Users" ("Id") ON DELETE SET NULL,
+    "VisitorToken" varchar(64),
+    "CreatedAtUtc" timestamptz NOT NULL DEFAULT now(),
+    CONSTRAINT "CK_ModelMediaViews_ModelSlug"
+        CHECK ("ModelSlug" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'),
+    CONSTRAINT "CK_ModelMediaViews_MediaType"
+        CHECK ("MediaType" IN ('photo', 'video'))
+);
+
+CREATE INDEX IF NOT EXISTS "IX_ModelMediaViews_ModelSlug_MediaKey"
+    ON "ModelMediaViews" ("ModelSlug", "MediaKey");
+CREATE INDEX IF NOT EXISTS "IX_ModelMediaViews_ModelSlug_MediaKey_ViewerId"
+    ON "ModelMediaViews" ("ModelSlug", "MediaKey", "ViewerId");
+CREATE INDEX IF NOT EXISTS "IX_ModelMediaViews_ModelSlug_MediaKey_VisitorToken"
+    ON "ModelMediaViews" ("ModelSlug", "MediaKey", "VisitorToken");
+
+CREATE TABLE IF NOT EXISTS "ModelMediaShares" (
+    "Id"           bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "ModelSlug"    varchar(120) NOT NULL,
+    "MediaType"    varchar(16) NOT NULL DEFAULT 'photo',
+    "MediaKey"     varchar(512) NOT NULL,
+    "ViewerId"     integer REFERENCES "Users" ("Id") ON DELETE SET NULL,
+    "VisitorToken" varchar(64),
+    "CreatedAtUtc" timestamptz NOT NULL DEFAULT now(),
+    CONSTRAINT "CK_ModelMediaShares_ModelSlug"
+        CHECK ("ModelSlug" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'),
+    CONSTRAINT "CK_ModelMediaShares_MediaType"
+        CHECK ("MediaType" IN ('photo', 'video'))
+);
+
+CREATE INDEX IF NOT EXISTS "IX_ModelMediaShares_ModelSlug_MediaKey"
+    ON "ModelMediaShares" ("ModelSlug", "MediaKey");
+CREATE INDEX IF NOT EXISTS "IX_ModelMediaShares_ModelSlug_MediaKey_ViewerId"
+    ON "ModelMediaShares" ("ModelSlug", "MediaKey", "ViewerId");
+CREATE INDEX IF NOT EXISTS "IX_ModelMediaShares_ModelSlug_MediaKey_VisitorToken"
+    ON "ModelMediaShares" ("ModelSlug", "MediaKey", "VisitorToken");
+
+CREATE TABLE IF NOT EXISTS "ModelMediaLikes" (
+    "Id"           bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "ModelSlug"    varchar(120) NOT NULL,
+    "MediaType"    varchar(16) NOT NULL DEFAULT 'photo',
+    "MediaKey"     varchar(512) NOT NULL,
+    "UserId"       integer NOT NULL REFERENCES "Users" ("Id") ON DELETE CASCADE,
+    "CreatedAtUtc" timestamptz NOT NULL DEFAULT now(),
+    CONSTRAINT "CK_ModelMediaLikes_ModelSlug"
+        CHECK ("ModelSlug" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'),
+    CONSTRAINT "CK_ModelMediaLikes_MediaType"
+        CHECK ("MediaType" IN ('photo', 'video'))
+);
+
+CREATE UNIQUE INDEX IF NOT EXISTS "UX_ModelMediaLikes_ModelSlug_MediaKey_UserId"
+    ON "ModelMediaLikes" ("ModelSlug", "MediaKey", "UserId");
+CREATE INDEX IF NOT EXISTS "IX_ModelMediaLikes_ModelSlug_MediaKey"
+    ON "ModelMediaLikes" ("ModelSlug", "MediaKey");
+
+CREATE TABLE IF NOT EXISTS "ModelMediaComments" (
+    "Id"           bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "ModelSlug"    varchar(120) NOT NULL,
+    "MediaType"    varchar(16) NOT NULL DEFAULT 'photo',
+    "MediaKey"     varchar(512) NOT NULL,
+    "AuthorId"     integer NOT NULL REFERENCES "Users" ("Id") ON DELETE CASCADE,
+    "Text"         varchar(1000) NOT NULL,
+    "CreatedAtUtc" timestamptz NOT NULL DEFAULT now(),
+    CONSTRAINT "CK_ModelMediaComments_ModelSlug"
+        CHECK ("ModelSlug" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'),
+    CONSTRAINT "CK_ModelMediaComments_MediaType"
+        CHECK ("MediaType" IN ('photo', 'video')),
+    CONSTRAINT "CK_ModelMediaComments_TextLength"
+        CHECK (char_length(btrim("Text")) BETWEEN 1 AND 1000)
+);
+
+CREATE INDEX IF NOT EXISTS "IX_ModelMediaComments_ModelSlug_MediaKey_CreatedAtUtc"
+    ON "ModelMediaComments" ("ModelSlug", "MediaKey", "CreatedAtUtc" DESC, "Id" DESC);
+CREATE INDEX IF NOT EXISTS "IX_ModelMediaComments_AuthorId"
+    ON "ModelMediaComments" ("AuthorId");

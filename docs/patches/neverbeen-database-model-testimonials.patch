diff --git a/schema.sql b/schema.sql
index af3a6a7..ef37a0a 100644
--- a/schema.sql
+++ b/schema.sql
@@ -234,1 +233,28 @@ CREATE UNIQUE INDEX IF NOT EXISTS "UX_CommentReactions_Comment_User"
+-- ---------------------------------------------------------------------------
+-- AI Model portfolio testimonials (public reads, active Community-member writes)
+-- ---------------------------------------------------------------------------
+
+CREATE TABLE IF NOT EXISTS "ModelTestimonials" (
+    "Id"           integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+    "ModelSlug"    varchar(120) NOT NULL,
+    "Headline"     varchar(100) NOT NULL,
+    "Text"         varchar(2500) NOT NULL,
+    "Rating"       numeric(2,1) NOT NULL,
+    "AuthorId"     integer NOT NULL REFERENCES "Users" ("Id") ON DELETE CASCADE,
+    "CreatedAtUtc" timestamptz NOT NULL DEFAULT now(),
+    CONSTRAINT "CK_ModelTestimonials_ModelSlug"
+        CHECK ("ModelSlug" ~ '^[a-z0-9]+(-[a-z0-9]+)*$'),
+    CONSTRAINT "CK_ModelTestimonials_HeadlineLength"
+        CHECK (char_length(btrim("Headline")) BETWEEN 10 AND 100),
+    CONSTRAINT "CK_ModelTestimonials_TextLength"
+        CHECK (char_length(btrim("Text")) BETWEEN 20 AND 2500),
+    CONSTRAINT "CK_ModelTestimonials_Rating"
+        CHECK ("Rating" >= 0.5 AND "Rating" <= 5 AND mod("Rating" * 2, 1) = 0)
+);
+
+CREATE INDEX IF NOT EXISTS "IX_ModelTestimonials_ModelSlug_CreatedAtUtc"
+    ON "ModelTestimonials" ("ModelSlug", "CreatedAtUtc" DESC, "Id" DESC);
+CREATE INDEX IF NOT EXISTS "IX_ModelTestimonials_AuthorId"
+    ON "ModelTestimonials" ("AuthorId");
+
 -- ---------------------------------------------------------------------------

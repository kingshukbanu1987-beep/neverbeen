+                IsoCode2 = element.GetProperty("iso2").GetString() ?? string.Empty,
+                Name = element.GetProperty("name").GetString() ?? string.Empty,
+                PhoneCode = element.TryGetProperty("phone", out var phone) ? phone.GetString() : null,

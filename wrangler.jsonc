{
  "name": "neverbeen",
  // Worker entry: serves the static app and handles /api/* (the model booking endpoint) so the
  // founder's WhatsApp number stays a server-side secret. It also proxies /neverbeen-api/* to the
  // NeverBeen Web API (member sign-up, sign-in and every other community call) so the Angular app
  // can use a same-origin API path with no CORS or mixed-content problems.
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-15",
  "vars": {
    // Base URL of the NeverBeen Web API. Change it when the API moves to another host.
    "NEVERBEEN_API_URL": "https://neverbeen-api-kingshuk-cqexbcb5hqbqavdb.westus3-01.azurewebsites.net",
    // Gemini key for Live Chat: the reading desk, her camera and the live-chat selfie service.
    // (A long-lived key belongs in `npx wrangler secret put GEMINI_API_KEY` rather than here —
    // this file is committed.)
    "GEMINI_API_KEY": "AQ.Ab8RN6KiXIBawUzfmF835eRQthsCJZDxJeaoWSA5SCUbk3jLWw",
    // The reading desk runs on gemini-2.5-flash. The two cameras need an **image-generation**
    // model: plain gemini-2.5-flash cannot answer responseModalities:["IMAGE"], and pinning the
    // cameras to it fails every selfie into the album fallback.
    "GEMINI_MODEL": "gemini-2.5-flash",
    "GEMINI_IMAGE_MODEL": "gemini-2.5-flash-image",
  },
  "assets": {
    "directory": "./dist/neverbeen/browser",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/neverbeen-api/*"],
    // Single-page-app mode: any URL that does not match a static file (deep links like
    // /community, /profile?id=…, /admin/… or any redirect target) serves index.html with
    // a 200, so refreshing the browser on any route loads the app instead of a 404.
    // The Angular router then resolves the route and CommunityService restores the
    // signed-in session from the auth cookie.
    "not_found_handling": "single-page-application",
  },
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NeverBeen": "Server=tcp:yourserver.database.windows.net,1433;Initial Catalog=NeverBeen;User ID=youradmin;Password=YourPassword;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Issuer": "NeverBeen.API",
    "Audience": "NeverBeen.Web",
    "SigningKey": "REPLACE_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS",
    "ExpiresInHours": "72"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:4200,https://localhost:4200"
  },
  "OAuth": {
    "FrontendRedirectUri": "http://localhost:4200/auth/callback",
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": ""
    },
    "Facebook": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": ""
    },
    "Microsoft": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": ""
    }
  }
}
